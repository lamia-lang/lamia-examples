"""
Selector smoke test for the LinkedIn feed. Logs in and checks that the HTML
selectors used by find_trending_word.lm still exist. Does not analyze or write
anything. LinkedIn changes its DOM over time — run this first if the main script
stops collecting posts, and update the selectors below plus the ones in
find_trending_word.lm to match.

Usage:  lamia tests/check_selectors.lm
"""

import time

LINKEDIN_EMAIL    = "your_email@example.com"
LINKEDIN_PASSWORD = "your_password"

LOGIN_URL = "https://www.linkedin.com/login"
FEED_URL  = "https://www.linkedin.com/feed/"

SELECTORS = [
    ("login_username", "#username"),
    ("login_password", "#password"),
    ("feed_container", "div.scaffold-finite-scroll__content"),
    ("feed_post", "div.feed-shared-update-v2"),
    ("post_actor_description", ".update-components-actor__description"),
    ("post_body", ".update-components-update-v2__commentary"),
]

def check_login():
    with session("linkedin", FEED_URL):
        web.navigate(LOGIN_URL)
        web.type_text("#username", LINKEDIN_EMAIL)
        web.type_text("#password", LINKEDIN_PASSWORD)
        web.click("button[type='submit']")
        time.sleep(5)

def run_checks():
    web.navigate(FEED_URL)
    time.sleep(6)
    failed = []
    for name, selector in SELECTORS:
        if web.is_visible(selector):
            print(f"PASS: {name}")
        else:
            print(f"FAIL: {name}")
            failed.append(name)
    if failed:
        print(f"Selector smoke test failed: {', '.join(failed)}")
    else:
        print("Selector smoke test passed.")

check_login()
run_checks()
