import time

PINTEREST_EMAIL    = "your_email@example.com"
PINTEREST_PASSWORD = "your_password"

SELECTORS = [
    ("upload_input", "//*[starts-with(@id, 'media-upload-input-')]"),
    ("title_input", "//*[starts-with(@id, 'pin-draft-title-')]"),
    ("description_input", "//*[starts-with(@id, 'pin-draft-description-')]"),
    ("link_input", "//*[starts-with(@id, 'pin-draft-link-')]"),
    ("board_dropdown", "//div[@data-test-id='board-dropdown-select-button']")
]

def login():
    with session("pinterest", "https://www.pinterest.com/"):
        web.navigate("https://www.pinterest.com/login/")
        web.type_text("input[name='id']", PINTEREST_EMAIL)
        web.type_text("input[name='password']", PINTEREST_PASSWORD)
        web.click("button[type='submit']")
        time.sleep(5)

def check_selectors():
    web.navigate("https://www.pinterest.com/pin-builder/")
    time.sleep(6)

    failed = []
    for name, selector in SELECTORS:
        if web.exists(selector):
            print(f"PASS: {name}")
        else:
            print(f"FAIL: {name}")
            failed.append(name)

    if failed:
        print(f"Selector smoke test failed: {', '.join(failed)}")
    else:
        print("Selector smoke test passed.")

login()
check_selectors()
